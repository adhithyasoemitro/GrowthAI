generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("sales")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  position        String
  company         String
  email           String   @unique
  whatsapp        String
  useCase         String
  volumeRange     String
  followUpPref    String
  demoHistory     String   @default("[]")
  intent          String   @default("medium")
  leadScore       Int      @default(50)
  scoreBreakdown  String   @default("{}")
  otpVerified     Boolean  @default(false)
  otpMasked       String   @default("")
  status          String   @default("new")
  disposition     String   @default("pending")
  dispositionNote String?
  trafficSource   String   @default("direct")
  utmParams       String   @default("{}")
  ipHash          String?
  userAgent       String?
  consentGiven    Boolean  @default(false)
  consentVersion  String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  events          Event[]
  assigneeId      String?
  assignee        User?    @relation(fields: [assigneeId], references: [id])
}

model Event {
  id        String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  event    String
  category String
  meta     String   @default("{}")
  createdAt DateTime @default(now())
}

model OTPAttempt {
  id           String   @id @default(cuid())
  phoneHash    String
  correlationId String
  otpCode      String
  status       String   @default("pending")
  retryCount   Int      @default(0)
  expiresAt    DateTime
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
}

model DemoSession {
  id          String   @id @default(cuid())
  leadId     String?
  sessionId  String   @unique
  demoType    String
  stepsCompleted Int @default(0)
  finalOutcome String?
  demoData    String   @default("{}")
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

model AdminActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  targetId  String?
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}
